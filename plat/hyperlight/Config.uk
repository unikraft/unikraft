menuconfig PLAT_HYPERLIGHT
	bool "Hyperlight guest"
	default n
	depends on ARCH_X86_64
	select LIBUKDEBUG
	select LIBUKBOOT
	select LIBUKBITOPS
	select LIBUKALLOC
	select LIBUKTIMECONV
	select LIBNOLIBC if !HAVE_LIBC
	select LIBPOSIX_ENVIRON
	select LIBUKATOMIC
	select LIBUKRELOC if OPTIMIZE_PIE
	select LIBUKPLAT_NATIVE_PAL
	select HAVE_PAGING
	select LIBUKPLAT_NATIVE_PAGING if LIBUKPAGING
	select LIBUKPLAT_NATIVE_LCPU_PM if LIBUKLCPU
	select HAVE_INTCTLR
	select LIBUKINTCTLR_HYPERLIGHT
	help
	  Create a Unikraft image that runs as a Hyperlight guest.
	  Hyperlight is a lightweight Virtual Machine Manager (VMM)
	  designed to be embedded within applications.

if (PLAT_HYPERLIGHT)

config HYPERLIGHT_MAX_GUEST_LOG_LEVEL
	int "Maximum guest log level (0=Off, 1=Error, 2=Warn, 3=Info, 4=Debug, 5=Trace)"
	default 3
	range 0 5
	help
	  Maximum log level that will be sent to the host.
	  0 = Off, 1 = Error, 2 = Warn, 3 = Info, 4 = Debug, 5 = Trace

config HYPERLIGHT_DEBUG_PRINT
	bool "Enable debug print to host"
	default n
	help
	  Enable debug print output via Hyperlight DebugPrint port (103).
	  Sends one byte per VM exit — slow, but works before any
	  shared memory infrastructure is set up. Useful for early
	  boot debugging only.

endif
