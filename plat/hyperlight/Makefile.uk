$(eval $(call addplat_s,hyperlight,$(CONFIG_PLAT_HYPERLIGHT)))
$(eval $(call addplatlib,hyperlight,libhyperlightplat))

##
## Platform library include paths and flags
##
LIBHYPERLIGHTPLAT_ASINCLUDES-y += -I$(LIBHYPERLIGHTPLAT_BASE)/include
LIBHYPERLIGHTPLAT_ASINCLUDES-y += -I$(UK_PLAT_COMMON_BASE)/include
LIBHYPERLIGHTPLAT_CINCLUDES-y  += -I$(LIBHYPERLIGHTPLAT_BASE)/paging/include
LIBHYPERLIGHTPLAT_CINCLUDES-y  += -I$(LIBHYPERLIGHTPLAT_BASE)/include
LIBHYPERLIGHTPLAT_CINCLUDES-y  += -I$(UK_PLAT_COMMON_BASE)/include
LIBHYPERLIGHTPLAT_CINCLUDES-y  += -I$(UK_PLAT_DRIVERS_BASE)/include

LIBHYPERLIGHTPLAT_ASFLAGS  += -DHYPERLIGHTPLAT -DUK_USE_SECTION_SEGMENTS
LIBHYPERLIGHTPLAT_CFLAGS   += -DHYPERLIGHTPLAT -DUK_USE_SECTION_SEGMENTS
LIBHYPERLIGHTPLAT_CXXFLAGS += -DHYPERLIGHTPLAT -DUK_USE_SECTION_SEGMENTS

##
## Default linker script
##
UK_PLAT_HYPERLIGHT_DEF_LDS := $(CONFIG_UK_BASE)/plat/hyperlight/x86/link64.lds.S

##
## Platform sources — added incrementally as each component is implemented.
##
## Common platform sources
LIBHYPERLIGHTPLAT_SRCS-y += $(UK_PLAT_COMMON_BASE)/memory.c|common
LIBHYPERLIGHTPLAT_SRCS-y += $(UK_PLAT_COMMON_BASE)/bootinfo.c|common
LIBHYPERLIGHTPLAT_SRCS-y += $(UK_PLAT_COMMON_BASE)/bootinfo.lds.S|common

## x86 sources
LIBHYPERLIGHTPLAT_SRCS-$(CONFIG_ARCH_X86_64) += $(LIBHYPERLIGHTPLAT_BASE)/x86/entry64.S|x86
LIBHYPERLIGHTPLAT_SRCS-$(CONFIG_ARCH_X86_64) += $(LIBHYPERLIGHTPLAT_BASE)/x86/lcpu_start.S
LIBHYPERLIGHTPLAT_SRCS-$(CONFIG_ARCH_X86_64) += $(LIBHYPERLIGHTPLAT_BASE)/x86/pagetable64.S
## IDT vector stubs (traps + IRQs) — shared with KVM
LIBHYPERLIGHTPLAT_SRCS-$(CONFIG_ARCH_X86_64) += $(CONFIG_UK_BASE)/plat/kvm/x86/cpu_vectors_x86_64.S
## SYSCALL entry — shared with KVM, needed for ring-3 apps (elfloader)
ifeq ($(CONFIG_HAVE_SYSCALL),y)
LIBHYPERLIGHTPLAT_SRCS-$(CONFIG_ARCH_X86_64) += $(UK_PLAT_COMMON_BASE)/x86/syscall.S|common
endif

## Platform sources
LIBHYPERLIGHTPLAT_SRCS-y += $(LIBHYPERLIGHTPLAT_BASE)/console.c
LIBHYPERLIGHTPLAT_SRCS-$(CONFIG_ARCH_X86_64) += $(LIBHYPERLIGHTPLAT_BASE)/x86/setup.c
LIBHYPERLIGHTPLAT_SRCS-y += $(LIBHYPERLIGHTPLAT_BASE)/shutdown.c
LIBHYPERLIGHTPLAT_SRCS-y += $(LIBHYPERLIGHTPLAT_BASE)/memory.c
LIBHYPERLIGHTPLAT_SRCS-y += $(LIBHYPERLIGHTPLAT_BASE)/cow.c
LIBHYPERLIGHTPLAT_SRCS-y += $(LIBHYPERLIGHTPLAT_BASE)/hcall.c
LIBHYPERLIGHTPLAT_SRCS-y += $(LIBHYPERLIGHTPLAT_BASE)/dispatch.c
LIBHYPERLIGHTPLAT_SRCS-$(CONFIG_HYPERLIGHT_STEP) += $(LIBHYPERLIGHTPLAT_BASE)/step.c
LIBHYPERLIGHTPLAT_SRCS-$(CONFIG_ARCH_X86_64) += $(LIBHYPERLIGHTPLAT_BASE)/x86/time.c

##
## Override ukpaging's arch.h with Hyperlight-specific paging translation.
## Library-specific CINCLUDES are searched before global CINCLUDES, so
## plat/hyperlight/paging/include/uk/paging/arch.h is found before
## lib/ukpaging/arch/x86_64/include/uk/paging/arch.h.
##
LIBUKPAGING_CINCLUDES-$(CONFIG_PLAT_HYPERLIGHT) += \
	-I$(LIBHYPERLIGHTPLAT_BASE)/paging/include
LIBUKPAGING_CINCLUDES-$(CONFIG_PLAT_HYPERLIGHT) += \
	-I$(LIBHYPERLIGHTPLAT_BASE)/include

## Linker script (processed as a source for dependency tracking)
LIBHYPERLIGHTPLAT_SRCS-y += $(UK_PLAT_HYPERLIGHT_DEF_LDS)
