menuconfig LIBUKACPI
	bool "ACPI drivers"
	depends on (ARCH_X86_64 || ARCH_ARM_64)
	help
		Drivers for operating with the ACPI specification.

if LIBUKACPI

config LIBUKACPI_POWER_BUTTON
	bool "ACPI fixed-hardware power button"
	depends on ARCH_X86_64 && LIBUKINTCTLR_XPIC
	depends on LIBUKPM
	select HAVE_SHUTDOWN_DISPATCHER
	help
		Receive the fixed power-button event using the firmware FADT
		legacy I/O registers and SCI. Request orderly system shutdown
		through ukpm. Control-method buttons and hardware-reduced or
		MMIO-only ACPI are not supported by this driver.

config LIBUKACPI_CHECKSUM
	bool "Verify ACPI structures' checksum"

config LIBUKACPI_MADT_FILL_CPU_IDMAP
	bool "Fill in the ID/IDX map at the core of per-CPU variables"
	depends on LIBUKPCPUVAR
	depends on ARCH_X86_64
	default y

endif
