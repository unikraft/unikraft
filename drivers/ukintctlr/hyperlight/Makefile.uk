$(eval $(call addlib_s,libukintctlr_hyperlight,$(CONFIG_LIBUKINTCTLR_HYPERLIGHT)))

ASINCLUDES-$(CONFIG_LIBUKINTCTLR_HYPERLIGHT)  += -I$(LIBUKINTCTLR_HYPERLIGHT_BASE)/include
CINCLUDES-$(CONFIG_LIBUKINTCTLR_HYPERLIGHT)   += -I$(LIBUKINTCTLR_HYPERLIGHT_BASE)/include
CXXINCLUDES-$(CONFIG_LIBUKINTCTLR_HYPERLIGHT) += -I$(LIBUKINTCTLR_HYPERLIGHT_BASE)/include

LIBUKINTCTLR_HYPERLIGHT_SRCS-y += $(LIBUKINTCTLR_HYPERLIGHT_BASE)/ukintctlr.c
