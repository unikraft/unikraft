menuconfig LIBPOSIX_FUTEX
	bool "posix-futex: Futex"
	select LIBNOLIBC if !HAVE_LIBC
	select LIBUKSCHED
	select LIBUKLOCK
	select LIBUKDEBUG
	select LIBUKLCPU
	default n
	help
		Linux-compatible futex calls

if LIBPOSIX_FUTEX
config LIBPOSIX_FUTEX_VAS
	bool
	depends on LIBPOSIX_PROCESS_MULTITHREADING
	depends on LIBUKVMEM_THREAD_VAS && LIBUKPAGING_DIRECTMAP
	depends on LIBUKPLAT_NATIVE_PAGING
	select LIBUKVMEM_PROCESS_VAS
	select LIBUKVMEM_VAS_ACCESS
	default n

config LIBPOSIX_FUTEX_DEBUG
	bool "Enable debug messages"
	default n

config LIBPOSIX_FUTEX_VAS_TEST
	bool "Test futexes across separate process address spaces"
	depends on LIBPOSIX_PROCESS_MULTITHREADING
	depends on LIBUKVMEM_THREAD_VAS && LIBUKPAGING_DIRECTMAP
	depends on LIBUKPLAT_NATIVE_PAGING && LIBUKLOCK_SEMAPHORE
	select LIBPOSIX_FUTEX_VAS
	select LIBUKPAGING_STATS
	select LIBUKTEST
	depends on LIBSYSCALL_SHIM
	default n

config LIBPOSIX_FUTEX_TEST
	bool "Enable tests"
	default n
	select LIBUKTEST
	select LIBSYSCALL_SHIM
endif
