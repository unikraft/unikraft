menuconfig LIBUKSCHED
	bool "uksched: Abstraction for schedulers"
	default n
	select LIBNOLIBC if !HAVE_LIBC
	select LIBUKDEBUG
	select LIBUKALLOC
	select HAVE_SCHED
	select LIBUKLCPU
	select LIBUKPCPUVAR

if LIBUKSCHED

# Invisible symbol to enable TCB initialization
config LIBUKSCHED_TCB_INIT
	bool

config LIBUKSCHED_DEBUG
	bool "Enable debug messages"

config LIBUKSCHED_STATS
	bool "Scheduler statistics"
	depends on LIBUKSTORE # circular dependency
	help
		Provide scheduler stats via ukstore

config LIBUKSCHED_MAX_PRIO
	int "Maximum thread priority value"
	range 1 255
	default 239
	help
		Maximum priority value that can be assigned to a thread
		via sched_setattr(). Must be >= 1.

endif
