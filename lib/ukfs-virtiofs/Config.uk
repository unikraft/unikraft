menuconfig LIBUKFS_VIRTIOFS
	bool "ukfs-virtiofs: Virtual I/O filesystem"
	select LIBVIRTIO_FS
	select LIBUKFILE
	select LIBUKFS

if LIBUKFS_VIRTIOFS

config LIBUKFS_VIRTIOFS_DEBUG
	bool "Compile development request tracing"
	depends on LIBUKDEBUG_ENABLE_ASSERT
	default n
	help
	  Include request opcode and identifier tracing. When disabled neither
	  the tracing calls nor their messages are part of the kernel.


config LIBUKFS_VIRTIOFS_IOMEM
	bool "Local file caching & direct memory I/O"
	select LIBUKPOD
	select LIBUKPOD_DEFAULT
	select LIBUKPOD_ANON
	select LIBUKSPARSEBUF
	help
		Support for the ukfile mem() operation, required for supporting
		shared file mappings.

config LIBUKFS_VIRTIOFS_TEST
	bool "Test FUSE protocol contracts"
	select LIBUKTEST
	default n

endif
