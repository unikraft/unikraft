menuconfig LIBPOSIX_PROCESS
	bool "posix-process: Process-related functions"
	select LIBNOLIBC if !HAVE_LIBC

if LIBPOSIX_PROCESS

menuconfig LIBPOSIX_PROCESS_PIDS
	bool "Process and thread IDs"
	select LIBUKSCHED

if LIBPOSIX_PROCESS_PIDS

config LIBPOSIX_PROCESS_MAX_PID
	int "Largest PID"
	range 1 32767
	default 31

endif

menuconfig LIBPOSIX_PROCESS_SIGNAL
	bool "POSIX signals (EXPERIMENTAL)"
	select LIBSYSCALL_SHIM
	select LIBUKLOCK

if LIBPOSIX_PROCESS_SIGNAL

config LIBPOSIX_PROCESS_SIGNAL_ALARM
	bool "alarm() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_PAUSE
	bool "pause() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_SIGALTSTACK
	bool "sigaltstack() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_RTSIGPENDING
	bool "rt_sigpending() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_RTSIGPROCMASK
	bool "rt_sigprocmask() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_RTSIGSUSPEND
	bool "rt_sigsuspend() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_RTSIGACTION
	bool "rt_sigaction() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_RTSIGQUEUEINFO
	bool "rt_sigqueueinfo() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_RTTGSIGQUEUEINFO
	bool "rt_tgsigqueueinfo() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_RTSIGTIMEDWAIT
	bool "rt_sigtimedwait() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_KILL
	bool "kill() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_TGKILL
	bool "tgkill() syscall"
	default y

config LIBPOSIX_PROCESS_SIGNAL_TKILL
	bool "tkill() syscall"
	default y
endif

menuconfig LIBPOSIX_PROCESS_GRACEFUL_SHUTDOWN
bool "Graceful shutdown"
select LIBPOSIX_PROCESS_PIDS
select LIBPOSIX_PROCESS_SIGNAL
select LIBUKLOCK
select LIBUKBOOT_MAINTHREAD #FIXME without this we get a build error on TIMEOUT_MS
help
	Signal processes on system shutdown, to give them
	a chance to terminate gracefully. If timeout is
	reached, processes are killed forecefully.

if LIBPOSIX_PROCESS_GRACEFUL_SHUTDOWN
config LIBPOSIX_PROCESS_GRACEFUL_SHUTDOWN_SIGNAL
int "Process termination signal"
default 15 if (ARCH_ARM_64 || ARCH_X86_64)
help
	Signal to send processes to gracefully terminate
	before killing forcefully during system shutdown.
	The default is SIGTERM.

config LIBPOSIX_PROCESS_GRACEFUL_SHUTDOWN_TIMEOUT_MS
int "Process termination timeout (ms)"
depends on LIBUKBOOT_MAINTHREAD
default 3000
help
	Time (ms) to wait for a process to gracefully terminate
	before killing forcefully during system shutdown.
endif

config LIBPOSIX_PROCESS_CLONE
	bool "clone() system call"
	select LIBPOSIX_PROCESS_PIDS

config LIBPOSIX_PROCESS_CLONE_PREFER_CHILD
	bool "Prefer scheduling of child"
	depends on LIBPOSIX_PROCESS_CLONE
	help
		If enabled, clone will context switch away from the clone
		caller. This is necessary for some applications that assume that
		the new thread does progress while the clone caller is not
		context switching.

config LIBPOSIX_PROCESS_EXECVE
	bool "execve() system call"
	select LIBPOSIX_PROCESS_PIDS
	select LIBUKBINFMT

config LIBPOSIX_PROCESS_VFORK
	bool "vfork() system call"
	select LIBPOSIX_PROCESS_PIDS
	select LIBPOSIX_PROCESS_CLONE

config LIBPOSIX_PROCESS_DEBUG
	bool "Enable debug messages"

endif
