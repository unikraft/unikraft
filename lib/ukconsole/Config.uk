menuconfig LIBUKCONSOLE
	bool "ukconsole: generic console driver interface"
	default y
	select LIBUKBITOPS
	select LIBUKLOCK
	select LIBUKLOCK_SPINLOCK

if LIBUKCONSOLE
config LIBUKCONSOLE_DEVICES_MAXCOUNT
	int "Maximum amount of registerable console devices"
	default 16

config LIBUKCONSOLE_TEST
	bool "Enable unit tests"
	select LIBUKTEST

config LIBUKCONSOLE_SMP_TEST
	bool "Test concurrent console lines on all CPUs"
	depends on HAVE_SMP && LIBUKPRINT_KLVL_INFO
	select LIBUKATOMIC
	select LIBUKLOCK_SEMAPHORE
	default n
endif
