menuconfig LIBUKLCPU
	bool "uklcpu: Generic logical CPU interface"
	select LIBUKPAL
	select LIBUKPCPUVAR
	default y

if LIBUKLCPU

if HAVE_SMP

config LIBUKLCPU_RUN_IRQ
	int "Remote Function IRQ#"
	default 5 if ARCH_ARM_64
	default 13 if ARCH_X86_64
	depends on HAVE_SMP

config LIBUKLCPU_WAKEUP_IRQ
	int "Wakeup IRQ#"
	default 6 if ARCH_ARM_64
	default 14 if ARCH_X86_64
	depends on HAVE_SMP

config LIBUKLCPU_SMP_TEST
	bool "Test secondary CPU startup and non-yielding overlap"
	depends on LIBUKTEST && LIBUKALLOC && ARCH_X86_64
	depends on LIBUKDEBUG_ENABLE_ASSERT
	depends on UKPLAT_CPU_MAXCOUNT <= 64
	default n
	help
	  Isolated test-kernel hardware probe. Does not enable application
	  threads on secondary CPUs or establish scheduler SMP safety.

endif

endif
