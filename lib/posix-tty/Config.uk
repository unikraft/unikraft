menuconfig LIBPOSIX_TTY
	bool "posix-tty: Support for stdin/out/err"
	select LIBPOSIX_FDIO

if LIBPOSIX_TTY

# Hidden, will autoselect if devfs is present
config LIBPOSIX_TTY_DEVFS
	bool
	default y if LIBUKFS_DEVFS
	help
	  Provide the "stdin", "stdout", and "stderr" special files under devfs,
	  made available when mounted e.g., under /dev.

config LIBPOSIX_TTY_SERIAL
	bool "Provide file driver for the serial console"
	select LIBUKCONSOLE

config LIBPOSIX_TTY_SERIAL_EOF_FINAL
	bool "End of input on the serial console is final"
	depends on LIBPOSIX_TTY_SERIAL
	default y if PLAT_HYPERLIGHT
	help
	  Treat an end of input (EOT, ^D) from the console as the end of
	  stdin for good, as it is on a platform whose console input is a
	  host buffer drained once: stdin then stays readable to poll() and
	  select(), and every read() returns 0 at once, as for the end of a
	  file or a pipe.  Without it an EOT ends one read, as on an
	  interactive terminal, and stdin reports no input until more
	  arrives: a program that polls stdin after the end then waits for
	  input that never comes.

config LIBPOSIX_TTY_SERIAL_STDERR
	bool "Separate standard error on the serial console"
	depends on LIBPOSIX_TTY_SERIAL
	default y if PLAT_HYPERLIGHT
	help
	  Open stderr (fd 2) as a serial file of its own, written with
	  uk_console_err(), instead of as a duplicate of stdout.  A console
	  driver with an err operation then receives standard error apart
	  from standard output; one without it prints both alike.

config LIBPOSIX_TTY_SERIAL_ONLCR
	bool "Translate newline to CR-LF on serial output"
	depends on LIBPOSIX_TTY_SERIAL
	default n if PLAT_HYPERLIGHT
	default y
	help
	  Write each newline written to the serial console as CR-LF, for
	  consoles that need a carriage return to start the next line.
	  Turn it off where the console hands a program's output to a host
	  that keeps its bytes, such as one capturing the output: the host
	  then sees the newlines the program wrote.

config LIBPOSIX_TTY_STDIO
	bool "Open standard I/O files at boot (fd 0, 1, 2)"
	select LIBPOSIX_FDTAB

if LIBPOSIX_TTY_STDIO

# Hidden, selected by appropriate choice
config LIBPOSIX_TTY_PSEUDO
	bool
	select LIBUKFILE_PSEUDO

choice LIBPOSIX_TTY_STDIN
	prompt "stdin:"

config LIBPOSIX_TTY_STDIN_NULL
	bool "NULL file: immediately return EOF"
	select LIBPOSIX_TTY_PSEUDO

config LIBPOSIX_TTY_STDIN_VOID
	bool "Void file: wait for input forever"
	select LIBPOSIX_TTY_PSEUDO

config LIBPOSIX_TTY_STDIN_SERIAL
	bool "Serial: platform-specific serial input"
	select LIBPOSIX_TTY_SERIAL

endchoice

choice LIBPOSIX_TTY_STDOUT
	prompt "stdout/err:"

config LIBPOSIX_TTY_STDOUT_SERIAL
	bool "Serial: platform-specific serial output"
	select LIBPOSIX_TTY_SERIAL

config LIBPOSIX_TTY_STDOUT_NULL
	bool "NULL file: discard output"
	select LIBPOSIX_TTY_PSEUDO

endchoice

endif

endif
