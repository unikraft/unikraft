menuconfig LIBUKVMEM
	bool "ukvmem: Virtual address space management"
	depends on HAVE_PAGING && HAVE_DYNAMIC_MAPPINGS
	select LIBUKDEBUG
	select LIBUKALLOC
	select LIBISRLIB
	select LIBUKPAGING
	select LIBUKLCPU
	help
		This library implements virtual address management by
		providing methods for working with virtual address space
		areas (VMAs) and performing paging decisions.

if LIBUKVMEM

config LIBUKVMEM_THREAD_VAS
	bool "Select the address space on thread switches"
	depends on HAVE_SCHED
	select LIBUKPAGING_SHARED
	help
		Allow threads to use an address space distinct from the kernel
		address space. All address spaces must map the kernel and its
		stacks and thread metadata at the same addresses.

config LIBUKVMEM_COW
	bool
	select LIBUKPAGING_DEFERRED_RELEASE
	default n

config LIBUKVMEM_VAS_BOUNDS
	bool
	default n

config LIBUKVMEM_PROCESS_VAS
	bool
	depends on LIBUKVMEM_THREAD_VAS && LIBUKPAGING_DIRECTMAP
	depends on LIBUKPLAT_NATIVE_PAGING
	select LIBUKVMEM_COW_VMA
	select LIBUKVMEM_VAS_BOUNDS
	default n

config LIBUKVMEM_COW_VMA
	bool
	depends on LIBUKVMEM_THREAD_VAS && LIBUKPAGING_DIRECTMAP
	select LIBUKVMEM_COW
	select LIBUKVMEM_VAS_REFCOUNT
	default n

config LIBUKVMEM_COW_VMA_TEST
	bool "Test private anonymous COW address space cloning"
	depends on LIBUKVMEM_THREAD_VAS && LIBUKPAGING_DIRECTMAP
	depends on LIBUKLOCK_SEMAPHORE
	depends on LIBUKVMEM_PAGEFAULT_HANDLER_PRIO > 0
	select LIBUKVMEM_COW_VMA
	select LIBUKVMEM_VAS_ACCESS
	select LIBUKVMEM_VAS_BOUNDS
	select LIBUKPAGING_STATS
	select LIBUKTEST
	default n

config LIBUKVMEM_VAS_REFCOUNT
	bool
	depends on LIBUKVMEM_THREAD_VAS
	default n

config LIBUKVMEM_VAS_ACCESS
	bool
	depends on LIBUKVMEM_THREAD_VAS && LIBUKPAGING_DIRECTMAP
	default n

config LIBUKVMEM_VAS_REFCOUNT_TEST
	bool "Test owned address space lifetime"
	depends on LIBUKVMEM_THREAD_VAS && LIBUKLOCK_SEMAPHORE
	depends on LIBUKPAGING_DIRECTMAP
	select LIBUKVMEM_VAS_REFCOUNT
	select LIBUKVMEM_VAS_ACCESS
	select LIBUKTEST
	default n

config LIBUKVMEM_COW_TEST
	bool "Test copy-on-write frame lifetime"
	depends on HAVE_SCHED
	select LIBUKVMEM_COW
	select LIBUKTEST

config LIBUKVMEM_COW_ALLOC_TEST
	bool "Test resident COW metadata allocation"
	depends on HAVE_SCHED && LIBUKLOCK_SEMAPHORE
	depends on LIBUKPAGING_DIRECTMAP
	select LIBUKVMEM_COW
	select LIBUKTEST
	default n

config LIBUKVMEM_FAULT_RESULT_TEST
	bool "Test staged fault ownership results"
	depends on LIBUKVMEM_THREAD_VAS && LIBUKPAGING_DIRECTMAP
	select LIBUKVMEM_COW
	select LIBUKVMEM_VAS_ACCESS
	select LIBUKTEST
	default n

config LIBUKVMEM_TRANSITION_TEST
	bool "Test VAS transition exclusion and fault completion IPIs"
	depends on LIBUKVMEM_THREAD_VAS && LIBUKPAGING_DIRECTMAP
	depends on LIBUKLOCK_SEMAPHORE
	depends on LIBUKVMEM_PAGEFAULT_HANDLER_PRIO > 0
	select LIBUKVMEM_COW
	select LIBUKVMEM_VAS_ACCESS
	select LIBUKTEST
	default n

config LIBUKVMEM_TRACE_PAGEFAULTS
	bool "Expose per-thread minor fault count for development measurements"
	depends on ARCH_X86_64 && HAVE_SCHED && LIBPOSIX_PROCESS
	depends on LIBUKDEBUG_ENABLE_ASSERT
	default n

config LIBUKVMEM_DEMAND_PAGE_IN_SIZE
	int "Page size in log2 for demand-paging"
	default 12
	help
		When a page fault occurs with demand paging the offending
		page is paged-in. This option decides which page size to
		use for the page-in operation if the VMA does not specify
		a page size.

config LIBUKVMEM_PAGEFAULT_HANDLER_PRIO
	int "Fault handler priority [0-9]"
	default 4
	range 0 9
	help
		Priority of the page fault handler. Determines the order in
		which the handler is called with respect to other handlers,
		0 (earliest) to 9 (latest). Faults handled by ukvmem are not
		propagated.

config LIBUKVMEM_DEFAULT_BASE
	hex "Default base address"
	default 0x0000001000000000

config LIBUKVMEM_DEDICATED_ANON_BASE
	bool "Use dedicated anonymous base"
	default no

config LIBUKVMEM_ANON_BASE
	hex "Anonymous memory"
	default 0x0000001000000000
	depends on LIBUKVMEM_DEDICATED_ANON_BASE

config LIBUKVMEM_DEDICATED_DMA_BASE
	bool "Use dedicated DMA base"
	default no

config LIBUKVMEM_DMA_BASE
	hex "Direct physical memory (DMA)"
	default 0x0000002000000000
	depends on LIBUKVMEM_DEDICATED_DMA_BASE

config LIBUKVMEM_DEDICATED_FILE_BASE
	bool "Use dedicated file base"
	default no

config LIBUKVMEM_FILE_BASE
	hex "File mappings"
	default 0x0000003000000000
	depends on LIBUKVMEM_DEDICATED_FILE_BASE

config LIBUKVMEM_DEDICATED_STACK_BASE
	bool "Use dedicated stack base"
	default no

config LIBUKVMEM_STACK_BASE
	hex "Stacks"
	default 0x0000004000000000
	depends on LIBUKVMEM_DEDICATED_STACK_BASE

config LIBUKVMEM_STACK_GUARD_PAGES_TOP
	int "Top guard pages count"
	default 4
	help
		Number of guard pages for the top of the stack (high address)

config LIBUKVMEM_STACK_GUARD_PAGES_BOTTOM
	int "Bottom guard pages count"
	default 1
	help
		Number of guard pages for the bottom of the stack (low address)

config LIBUKVMEM_TEST
	bool "Enable unit tests"
	default n
	select LIBUKTEST
	select LIBUKNOFAULT

config LIBUKVMEM_THREAD_VAS_TEST
	bool "Test address-space switches"
	depends on LIBUKVMEM_THREAD_VAS
	select LIBUKTEST

config LIBUKVMEM_SYNC_TEST
	bool "Test backing-store synchronization contracts"
	default n
	select LIBUKTEST

config LIBUKVMEM_NESTED_FAULT_TEST
	bool "Test nested native x86 page faults"
	depends on ARCH_X86_64 && LIBUKPLAT_NATIVE_EXCEPT && HAVE_SCHED
	depends on LIBUKVMEM_PAGEFAULT_HANDLER_PRIO > 0
	depends on LIBUKLOCK_SEMAPHORE
	select LIBUKTEST

endif
