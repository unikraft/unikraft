$(eval $(call addlib_s,libukvmem,$(CONFIG_LIBUKVMEM)))

CINCLUDES-y   += -I$(LIBUKVMEM_BASE)/include
CXXINCLUDES-y += -I$(LIBUKVMEM_BASE)/include

LIBUKVMEM_SRCS-y += $(LIBUKVMEM_BASE)/vmem.c|isr
LIBUKVMEM_SRCS-y += $(LIBUKVMEM_BASE)/vma_rsvd.c|isr
LIBUKVMEM_SRCS-y += $(LIBUKVMEM_BASE)/vma_anon.c|isr
LIBUKVMEM_SRCS-y += $(LIBUKVMEM_BASE)/vma_stack.c|isr
LIBUKVMEM_SRCS-y += $(LIBUKVMEM_BASE)/vma_dma.c|isr
LIBUKVMEM_SRCS-$(CONFIG_LIBUKVMEM_COW) += $(LIBUKVMEM_BASE)/cow.c|isr
LIBUKVMEM_SRCS-$(CONFIG_LIBUKVMEM_COW) += $(LIBUKVMEM_BASE)/cow_alloc.c|isr
LIBUKVMEM_SRCS-$(CONFIG_LIBUKVMEM_COW_TEST) += \
	$(LIBUKVMEM_BASE)/tests/test_cow.c|isr
LIBUKVMEM_SRCS-$(CONFIG_LIBUKVMEM_COW_ALLOC_TEST) += \
	$(LIBUKVMEM_BASE)/tests/test_cow_alloc.c
LIBUKVMEM_SRCS-$(CONFIG_LIBUKVMEM_VAS_REFCOUNT_TEST) += \
	$(LIBUKVMEM_BASE)/tests/test_vas_ref.c

ifeq ($(CONFIG_HAVE_PAGING),y)
LIBUKVMEM_SRCS-$(CONFIG_ARCH_X86_64) += \
	$(LIBUKVMEM_BASE)/arch/x86_64/pagefault.c|isr
LIBUKVMEM_SRCS-$(CONFIG_ARCH_ARM_64) += \
	$(LIBUKVMEM_BASE)/arch/arm/pagefault64.c|isr
endif

ifneq ($(filter y,$(CONFIG_LIBUKVMEM_TEST) $(CONFIG_LIBUKTEST_ALL)),)
CINCLUDES-y   += -I$(LIBUKVMEM_BASE)/tests/include
CXXINCLUDES-y += -I$(LIBUKVMEM_BASE)/tests/include

LIBUKVMEM_SRCS-y += $(LIBUKVMEM_BASE)/tests/test_vmem.c
endif

LIBUKVMEM_SRCS-$(CONFIG_LIBUKVMEM_SYNC_TEST) += $(LIBUKVMEM_BASE)/tests/test_vma_sync.c
LIBUKVMEM_SRCS-$(CONFIG_LIBUKVMEM_NESTED_FAULT_TEST) += \
	$(LIBUKVMEM_BASE)/tests/test_nested_fault.c|isr
LIBUKVMEM_SRCS-$(CONFIG_LIBUKVMEM_THREAD_VAS_TEST) += \
	$(LIBUKVMEM_BASE)/tests/test_vas_sched.c
LIBUKVMEM_SRCS-$(CONFIG_LIBUKVMEM_THREAD_VAS_TEST) += \
	$(LIBUKVMEM_BASE)/tests/test_vas_fault.c
