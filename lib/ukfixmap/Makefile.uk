$(eval $(call addlib_s,libukfixmap,$(CONFIG_LIBUKFIXMAP)))

ASINCLUDES-$(CONFIG_LIBUKFIXMAP)  += -I$(LIBUKFIXMAP_BASE)/include
CINCLUDES-$(CONFIG_LIBUKFIXMAP)   += -I$(LIBUKFIXMAP_BASE)/include
CXXINCLUDES-$(CONFIG_LIBUKFIXMAP) += -I$(LIBUKFIXMAP_BASE)/include

LIBUKFIXMAP_SRCS-y += $(LIBUKFIXMAP_BASE)/fixmap.c
