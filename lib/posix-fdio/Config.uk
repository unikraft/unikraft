menuconfig LIBPOSIX_FDIO
	bool "posix-fdio: File I/O and control"
	select LIBUKATOMIC
	select LIBUKFILE
	select LIBPOSIX_FD
	select LIBPOSIX_TIME
	select LIBUKTIMECONV
	imply LIBPOSIX_FDTAB
	select LIBPOSIX_FDTAB_LEGACY_SHIM if LIBPOSIX_FDTAB

if LIBPOSIX_FDIO

config LIBPOSIX_FDIO_VMA
	bool "File memory mappings"
	depends on LIBUKVMEM
	default y
	help
	  Private mappings use independent copies. Shared mappings alias file
	  backing pages through ACQUIRE_PINNED/RETRIEVE/RELEASE and require an
	  explicit physical pin guarantee from the file driver. They eagerly
	  acquire the mapped range; unsupported backends fail rather than copy.


endif
