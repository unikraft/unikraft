menuconfig LIBUKPAGING
	bool "ukpaging: Virtual memory API"
	depends on HAVE_PAGING
	select LIBUKPAL
	select LIBUKPT
	select LIBUKFALLOC
	select LIBUKFALLOCBUDDY
	help
		Provides a virtual memory API on top of libukpt. Each page
		table is backed by a frame allocator, which provides memory
		for new page tables / mapped pages on demand. The API also
		provides operations on address ranges and page table cloning.
		For raw page table operations use libukpt.

if LIBUKPAGING
config LIBUKPAGING_DIRECTMAP
	bool
	default y if ARCH_ARM_64 || ARCH_X86_64

config LIBUKPAGING_5LEVEL
	bool "Enable 5-level paging (EXPERIMENTAL)"
	depends on ARCH_X86_64 && HAVE_5LEVEL_PT

config LIBUKPAGING_STATS
	bool "Collect paging statistics"
endif
